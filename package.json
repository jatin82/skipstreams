{
  "name": "primevideo-tizenbrew",
  "appName": "Prime Video (Ad Skip)",
  "version": "1.4.2",
  "description": "TizenBrew site-modification module: Prime Video on Samsung Tizen TVs with ad skipping, no images/animations, auto-play on title pages, a remote cursor and remote seeking.",
  "packageType": "mods",
  "websiteURL": "https://www.primevideo.com/robots.txt",
  "main": "userScript.js",
  "keys": [
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "ColorF0Red",
    "ColorF1Green"
  ],
  "files": [
    "userScript.js"
  ],
  "keywords": ["tizenbrew", "tizen", "samsung", "primevideo"],
  "scripts": {
    "check": "node --check userScript.js",
    "test": "node --test userScript.test.js local-tizenbrew.test.js",
    "test:local": "playwright test",
    "test:local:headed": "playwright test --headed",
    "local:live": "node local-tizenbrew.js"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  },
  "license": "MIT"
}
