{
  "name": "prime-tizen-tv-app",
  "private": true,
  "version": "1.2.0",
  "description": "Samsung Tizen TV app (.wgt) for Prime Video plus a PC companion that injects the ad-skip/remote-cursor script.",
  "scripts": {
    "package": "node build.js",
    "install-tv": "node build.js --install",
    "watch": "node companion.js",
    "package-hotstar": "node build.js --app hotstar",
    "install-hotstar": "node build.js --app hotstar --install",
    "hotstar": "node companion.js hotstar"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.25.7"
  },
  "license": "MIT"
}
